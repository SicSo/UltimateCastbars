<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\UI.xsd">

	<Button name="UCB_BlackThreeSlice" mixin="UCB_BlackThreeSliceMixin" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="138" y="28"/>

		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
		<PushedTextOffset x="-2" y="-1"/>

		<KeyValues>
			<KeyValue key="file" value="Interface\AddOns\UltimateCastbars\gfx\UITextures\black_recolor_v2.png" type="string"/>
			<KeyValue key="fileRed" value="Interface\AddOns\UltimateCastbars\gfx\UITextures\128redbutton.png" type="string"/>
			<KeyValue key="texWidth" value="1024" type="number"/>
			<KeyValue key="texHeight" value="512" type="number"/>

			<KeyValue key="normalLeft" value="0.763671875,0.986328125,0.44482421875,0.50732421875" type="string"/>
			<KeyValue key="normalCenter" value="0.0,0.125,0.00048828125,0.06298828125" type="string"/>
			<KeyValue key="normalRight" value="0.001953125,0.572265625,0.25439453125,0.31689453125" type="string"/>

			<KeyValue key="pressedLeft" value="0.763671875,0.986328125,0.57177734,0.63427734375" type="string"/>
			<KeyValue key="pressedCenter" value="0.0,0.125,0.12744140625,0.18994140625" type="string"/>
			<KeyValue key="pressedRight" value="0.001953125,0.572265625,0.38134765625,0.44384765625" type="string"/>

			<KeyValue key="disabledLeft" value="0.763671875,0.986328125,0.50830078125,0.57080078125" type="string"/>
			<KeyValue key="disabledCenter" value="0.0,0.125,0.06396484375,0.12646484375" type="string"/>
			<KeyValue key="disabledRight" value="0.001953125,0.572265625,0.31787109375,0.38037109375" type="string"/>

			<KeyValue key="highlightTexCoords" value="0.001953125,0.86328125,0.19091796875,0.25341796875" type="string"/>

			<KeyValue key="leftWidth" value="114" type="number"/>
			<KeyValue key="centerWidth" value="64" type="number"/>
			<KeyValue key="rightWidth" value="292" type="number"/>
			<KeyValue key="artHeight" value="128" type="number"/>

			<KeyValue key="highlightWidth" value="441" type="number"/>
			<KeyValue key="highlightHeight" value="128" type="number"/>
		</KeyValues>

		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left">
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>

				<Texture parentKey="Right">
					<Anchors>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
				</Texture>

				<Texture parentKey="Center" horizTile="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
			</Layer>

			<Layer level="OVERLAY">
				<Texture parentKey="Highlight" hidden="true"/>
			</Layer>
		</Layers>

		<Frames>
			<Frame parentKey="Controller" mixin="ButtonControllerMixin">
				<Scripts>
					<OnLoad method="OnLoad"/>
					<OnShow method="OnShow"/>
				</Scripts>
			</Frame>
		</Frames>

		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="UpdateButton"/>
			<OnDisable method="OnDisable"/>
			<OnEnable method="OnEnable"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnSizeChanged method="OnSizeChanged"/>
		</Scripts>
	</Button>
</Ui>