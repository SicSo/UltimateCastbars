<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\UI.xsd">

	<Button name="UCBButtonTemplate" mixin="UCBButtonMixin" motionScriptsWhileDisabled="true" virtual="true">
		<Size x="140" y="24"/>

		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>

		<KeyValues>
			<!-- Default side widths; left and right are intentionally identical -->
			<KeyValue key="sideWidth" value="8" type="number"/>
		</KeyValues>

		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left">
					<Size x="20" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="1" top="0" bottom="1"/>
				</Texture>

				<Texture parentKey="Right">
					<Size x="20" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="1" top="0" bottom="1"/>
				</Texture>

				<Texture parentKey="Middle">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="1" top="0" bottom="1"/>
				</Texture>
			</Layer>
		</Layers>

		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnShow method="UpdateVisualState"/>
			<OnSizeChanged method="OnSizeChanged"/>
		</Scripts>
	</Button>
</Ui>