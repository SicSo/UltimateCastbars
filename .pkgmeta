package-as: UltimateCastbars

move-folders:
  UltimateCastbars: UltimateCastbars

manual-changelog: 
  filename: CHANGELOG.md
  markup-type: markdown
changelog-title: UltimateCastbars

ignore:
  - .github/**
  - README.md
  - LICENSE.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - update.py
  - make_release.sh
  - .gitignore